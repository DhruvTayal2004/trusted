# ---- Mobile app (safe to ship: anon key is public, protected by RLS) ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---- Edge functions (server-side ONLY — set with `supabase secrets set`, never EXPO_PUBLIC_) ----
# AI provider: "anthropic" | "openai". Falls back to "none" (features show "AI not connected") when no key is present.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# Speech-to-text for voice orders (OpenAI Whisper-compatible). Leave blank to use typed Hinglish input only.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# WhatsApp Business Cloud API (Meta). Leave blank → notifications are logged to notifications_outbox with
# status 'skipped_no_provider' and shown in-app as NOT DELIVERED.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Employee PIN login: edge function signs employees in using a per-employee secret derived from this pepper.
# Generate with: openssl rand -hex 32
EMPLOYEE_AUTH_PEPPER=
# Supabase provides these automatically inside edge functions; set only for local `supabase functions serve`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
